{
  "_comment": [
    "BRAELINN POKER LEAGUE \u2014 Firebase Realtime Database rules.",
    "DO NOT PASTE THIS FILE INTO FIREBASE. It has _comment keys, which",
    "Firebase rejects with: expected 'rules' property. Paste the generated",
    "file FIREBASE-RULES-PASTE-THIS.json instead. Edit THIS file, then run",
    "python3 make-rules.py to regenerate the one you paste.",
    "Read SECURITY.md first. Short version: these rules protect your tournament",
    "HISTORY, which is the only irreplaceable data. They cannot distinguish the",
    "host from a player, because that requires server-side verification that a",
    "static site with no accounts cannot do."
  ],
  "rules": {
    ".read": false,
    ".write": false,
    "leagues": {
      "braelinn": {
        ".read": true,
        "config": {
          ".write": true,
          "money": {
            "_comment": "Kitty % and payout splits, set by the host on game night.",
            "kittyPct": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            },
            "splits": {
              ".validate": "newData.hasChildren()"
            },
            "_plan": "How the host said it out loud: a fixed kitty in dollars, what 1st takes, and how many places pay. Everything below 1st is derived.",
            "kittyAmount": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "firstPrize": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 10000"
            },
            "places": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
            },
            "$other": {
              ".validate": false
            }
          },
          "pin": {
            ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 12"
          },
          "$other": {
            ".validate": false
          }
        },
        "photos": {
          "_comment": [
            "Player-uploaded avatars, stored as small JPEG data URLs.",
            "The 40000-char cap is what stops someone pasting a 4MB image",
            "into the database and blowing through the free tier."
          ],
          ".write": true,
          "$player": {
            ".validate": "newData.isString() && newData.val().length <= 40000 && newData.val().beginsWith('data:image/')"
          }
        },
        "rsvp": {
          "$gameId": {
            ".write": true,
            "$player": {
              ".validate": "newData.isString() && newData.val().matches(/^(in|maybe|out)$/)"
            }
          }
        },
        "live": {
          "$gameId": {
            ".write": true,
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(checkin|running|final)$/)"
            },
            "players": {
              "$player": {
                ".validate": "newData.hasChildren(['status'])",
                "status": {
                  ".validate": "newData.val().matches(/^(active|out)$/)"
                },
                "bustAt": {
                  ".validate": "newData.isNumber() || !newData.exists()"
                },
                "stack": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
                },
                "stackAt": {
                  ".validate": "newData.isNumber()"
                },
                "stackBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "rebuyBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "rebuyAt": {
                  ".validate": "newData.isNumber()"
                },
                "buyins": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
                },
                "rebuys": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
                },
                "late": {
                  ".validate": "newData.isBoolean()"
                },
                "bonus": {
                  ".validate": "newData.isBoolean()"
                },
                "joinedAt": {
                  ".validate": "newData.isNumber()"
                },
                "_money": "What a player OWES is derived from buyins/rebuys. What they have PAID is a number they or the host set -- a total, never a delta, so a retry cannot double-count.",
                "paid": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
                },
                "paidAt": {
                  ".validate": "newData.isNumber()"
                },
                "paidBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "inBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "_outBy": "Who knocked them out. The one fact the app can never derive -- it turns a stat sheet into a story.",
                "outBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "reports": {
              "$id": {
                ".validate": "newData.hasChildren(['name','type','at'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "type": {
                  ".validate": "newData.val().matches(/^(out|win)$/)"
                },
                "at": {
                  ".validate": "newData.isNumber()"
                },
                "_by": "Who the player says knocked them out. The player answers, not the host -- they know, and the host is busy.",
                "by": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "_bounty": "$20 on the last winner's head, stacking per consecutive win. Only who took it is stored -- the amount and the target are derived from finalized results, so a bad write here can misdirect the money but never invent it.",
            "bounty": {
              "target": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "wonBy": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "amount": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "_highHand": "Best hand of the night. Category only -- nobody types five cards at 11pm -- claimed by whoever hit it.",
            "highHand": {
              "name": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "cat": {
                ".validate": "newData.isString() && newData.val().matches(/^(royal|sflush|quads|boat|flush|straight|trips|twopair|pair)$/)"
              },
              "note": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "at": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "seats": {
              "tables": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
              },
              "order": {
                ".validate": "newData.hasChildren()"
              },
              "drawnAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            },
            "timer": {
              "running": {
                ".validate": "newData.isBoolean()"
              },
              "paused": {
                ".validate": "newData.isBoolean()"
              },
              "startedAt": {
                ".validate": "newData.isNumber()"
              },
              "elapsedBefore": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "results": {
          "$gameId": {
            "_comment": [
              "APPEND-ONLY. This is the rule that actually matters.",
              "A finalized game may be created once. It can never be edited or",
              "deleted from the app, by accident or otherwise. Season standings",
              "derive from these records, so protecting them protects the season.",
              "To correct a genuinely wrong result, edit it in the Firebase",
              "Console by hand -- deliberately awkward, which is the point."
            ],
            ".write": "!data.exists() && newData.exists()",
            ".validate": "newData.hasChildren(['gameId','date','field','finish','winner','finalizedAt'])",
            "gameId": {
              ".validate": "newData.isString()"
            },
            "date": {
              ".validate": "newData.isString()"
            },
            "season": {
              ".validate": "newData.isNumber()"
            },
            "label": {
              ".validate": "newData.isString()"
            },
            "field": {
              ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 100"
            },
            "winner": {
              ".validate": "newData.isString()"
            },
            "finalizedAt": {
              ".validate": "newData.isNumber()"
            },
            "type": {
              ".validate": "newData.isString()"
            },
            "finish": {
              "$row": {
                ".validate": "newData.hasChildren(['place','name','points'])",
                "place": {
                  ".validate": "newData.isNumber() && newData.val() >= 1"
                },
                "name": {
                  ".validate": "newData.isString()"
                },
                "points": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "winnings": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "rebuys": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "itm": {
                  ".validate": "newData.isBoolean()"
                },
                "late": {
                  ".validate": "newData.isBoolean()"
                },
                "outBy": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "$other": {
                  ".validate": false
                },
                "bounty": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                }
              }
            },
            "$other": {
              ".validate": true
            }
          }
        }
      }
    }
  }
}
